{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "sortImports": true,
  "sortPackageJson": {
    "sortScripts": true
  },
  "ignorePatterns": [
    "*.min.js",
    "/dist/",
    "coverage/",
    "public/",
    "src/twc/*",
    "!src/twc/template/",
    "pnpm-lock.yaml",
    "/src/style/"
  ]
}
